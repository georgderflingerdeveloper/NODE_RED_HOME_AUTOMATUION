{
    // Verwendet IntelliSense zum Ermitteln möglicher Attribute.
    // Zeigen Sie auf vorhandene Attribute, um die zugehörigen Beschreibungen anzuzeigen.
    // Weitere Informationen finden Sie unter https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        
        {
            "type": "node",
            "request": "launch",
            "name": "Programm starten",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}\\lib\\functions\\INIT_PHIDGETS_DIGITAL_OUTPUT_INLINE.js"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Unit-Tests (alle)",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "runtimeArgs": [
                "--test"
            ],
            "program": "${workspaceFolder}/test/*.test.mjs"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Aktuelle JavaScript-Testdatei",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "runtimeArgs": [
                "--test"
            ],
            "program": "${file}"
        }
    ]
}
