    "props": [
      {
        "p": "payload"
      },
      {
        "p": "topic",
        "v": "system/vault/probe",
        "vt": "str"
      }
    ],
    "repeat": "60",
    "crontab": "",
    "once": true,
    "onceDelay": "15",
    "topic": "system/vault/probe",
    "payload": "",
    "payloadType": "date",
    "x": 270,
    "y": 420,
    "wires": [
      [
        "system_credential_vault"
      ]
    ]
  },
  {
    "id": "system_live_metrics_result",
    "type": "function",
    "z": "system_network_flow",
    "name": "Livewerte prüfen und Dashboard aktualisieren",
    "func": {
      "$flowSource": "flows/system-netzwerk-scan--system_network_flow/functions/livewerte-prufen-und-dashboard-aktualisieren.js"
    },
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1000,
    "y": 580,
    "wires": [
      [
        "system_scan_result"
      ]
    ]
  },
  {
    "id": "system_credential_vault",
    "type": "home-automation-credential-vault",
    "z": "system_network_flow",
    "name": "Verschlüsselter System-Zugangstresor",
    "vaultPath": "system-credentials.vault.json",
    "autoLockMinutes": 10,
    "x": 610,
    "y": 540,
    "wires": [
      [
        "system_vault_response_out"
      ],
      [
        "system_live_metrics_result"
      ]
    ]
  },
  {
    "id": "system_vault_command_in",
    "type": "link in",
    "z": "system_network_flow",
    "name": "Tresorbefehl vom SYSTEM-Dashboard",
    "links": [
      "system_vault_command_out"
    ],
    "x": 345,
    "y": 480,
    "wires": [
      [
        "system_credential_vault"
      ]
    ]
  },
  {
    "id": "system_vault_response_out",
    "type": "link out",
    "z": "system_network_flow",
    "name": "Tresorstatus an SYSTEM-Dashboard",
    "mode": "link",
    "links": [
      "system_vault_response_in"
    ],
    "x": 850,
    "y": 480,
    "wires": []
  }
]
