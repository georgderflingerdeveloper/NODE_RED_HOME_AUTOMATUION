[
  {
    "id": "system_network_flow",
    "type": "tab",
    "label": "System · Netzwerk-Scan",
    "disabled": false,
    "info": "Eigenständiger, gedrosselter ICMP-Scan des lokalen /24-Heimnetzes. Es werden nur erreichbare Geräte an das SYSTEM-Dashboard gemeldet; nicht antwortende IP-Adressen werden nicht als Geräte interpretiert.",
    "env": []
  },
  {
    "id": "system_scan_schedule",
    "type": "inject",
    "z": "system_network_flow",
    "name": "Systemnetz beim Start und alle 5 Minuten scannen",
    "props": [
      {"p": "payload"},
      {"p": "topic", "v": "system/network/scan", "vt": "str"}
    ],
    "repeat": "300",
    "crontab": "",
    "once": true,
    "onceDelay": "8",
    "topic": "system/network/scan",
    "payload": "",
    "payloadType": "date",
    "x": 245,
    "y": 120,
    "wires": [["system_local_ip_exec"]]
  },
  {
    "id": "system_live_metrics_schedule",
    "type": "inject",
    "z": "system_network_flow",
    "name": "Raspberry-Pi-Livewerte jede Minute abrufen",
    "props": [{"p": "payload"}],
    "repeat": "60",
    "crontab": "",
    "once": true,
    "onceDelay": "15",
    "topic": "system/live/metrics",
    "payload": "",
    "payloadType": "date",
    "x": 270,
    "y": 420,
    "wires": [["system_live_metrics_exec"]]
  },
  {
    "id": "system_live_metrics_exec",
    "type": "exec",
    "z": "system_network_flow",
    "command": "/bin/sh -c '/usr/bin/env node \"$HOME/.node-red/projects/GEORGSHOME/tools/system-live-metrics.mjs\"'",
    "addpay": false,
    "append": "",
    "useSpawn": "false",
    "timer": "45",
    "winHide": false,
    "oldrc": false,
    "name": "Livewerte per SSH lesen (ohne Passwort im Flow)",
    "x": 570,
    "y": 420,
    "wires": [["system_live_metrics_result"], [], []]
  },
  {
    "id": "system_live_metrics_result",
    "type": "function",
    "z": "system_network_flow",
    "name": "Livewerte prüfen und Dashboard aktualisieren",
    "func": {"$flowSource": "flows/system-netzwerk--system_network_flow/functions/livewerte-prufen-und-dashboard-aktualisieren.js"},
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 885,
    "y": 420,
    "wires": [["system_scan_result"]]
  },
  {
    "id": "system_local_ip_exec",
    "type": "exec",
    "z": "system_network_flow",
    "command": "/bin/hostname -I",
    "addpay": false,
    "append": "",
    "useSpawn": "false",
    "timer": "5",
    "winHide": false,
    "oldrc": false,
    "name": "Lokale IPv4-Adresse ermitteln",
    "x": 525,
    "y": 120,
    "wires": [["system_scan_targets"], [], []]
  },
  {
    "id": "system_scan_targets",
    "type": "function",
    "z": "system_network_flow",
    "name": "Lokales /24-Scan-Netz sicher ableiten",
    "func": {"$flowSource": "flows/system-netzwerk--system_network_flow/functions/lokales-scan-netz-sicher-ableiten.js"},
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 790,
    "y": 120,
    "wires": [["system_scan_split"]]
  },
  {
    "id": "system_scan_split",
    "type": "split",
    "z": "system_network_flow",
    "name": "Ein Ping je Netzadresse",
    "splt": "\\n",
    "spltType": "str",
    "arraySplt": "1",
    "arraySpltType": "len",
    "stream": false,
    "addname": "",
    "property": "payload",
    "x": 1030,
    "y": 120,
    "wires": [["system_scan_target_property"]]
  },
  {
    "id": "system_scan_target_property",
    "type": "change",
    "z": "system_network_flow",
    "name": "Ziel-IP für Auswertung merken",
    "rules": [{"t": "set", "p": "targetIp", "pt": "msg", "to": "payload", "tot": "msg"}],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 1265,
    "y": 120,
    "wires": [["system_scan_rate_limit"]]
  },
  {
    "id": "system_scan_rate_limit",
    "type": "delay",
    "z": "system_network_flow",
    "name": "Gedrosselt · maximal 8 Prüfungen/Sekunde",
    "pauseType": "rate",
    "timeout": "5",
    "timeoutUnits": "seconds",
    "rate": "8",
    "nbRateUnits": "1",
    "rateUnits": "second",
    "randomFirst": "1",
    "randomLast": "5",
    "randomUnits": "seconds",
    "drop": false,
    "allowrate": false,
    "outputs": 1,
    "x": 240,
    "y": 220,
    "wires": [["system_ping_exec"]]
  },
  {
    "id": "system_ping_exec",
    "type": "exec",
    "z": "system_network_flow",
    "command": "/bin/ping -c 1 -W 1",
    "addpay": true,
    "append": "",
    "useSpawn": "false",
    "timer": "2",
    "winHide": false,
    "oldrc": false,
    "name": "Erreichbarkeit prüfen (ICMP)",
    "x": 510,
    "y": 220,
    "wires": [[], [], ["system_ping_result"]]
  },
  {
    "id": "system_ping_result",
    "type": "function",
    "z": "system_network_flow",
    "name": "Ping-Ergebnis sicher auswerten",
    "func": {"$flowSource": "flows/system-netzwerk--system_network_flow/functions/ping-ergebnis-sicher-auswerten.js"},
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 765,
    "y": 220,
    "wires": [["system_hostname_exec"], ["system_scan_result"]]
  },
  {
    "id": "system_hostname_exec",
    "type": "exec",
    "z": "system_network_flow",
    "command": "/bin/sh -c 'name=$(/usr/bin/dig +time=1 +tries=1 -x \"$1\" +short | /usr/bin/head -n 1 | /usr/bin/tr -d \"\\n\"); printf \"__SYSTEM_HOSTNAME__%s\\n\" \"$name\"' system-hostname",
    "addpay": true,
    "append": "",
    "useSpawn": "false",
    "timer": "3",
    "winHide": false,
    "oldrc": false,
    "name": "Hostname für Online-Gerät auflösen",
    "x": 1035,
    "y": 180,
    "wires": [["system_hostname_result"], [], []]
  },
  {
    "id": "system_hostname_result",
    "type": "function",
    "z": "system_network_flow",
    "name": "Hostname sicher übernehmen",
    "func": {"$flowSource": "flows/system-netzwerk--system_network_flow/functions/hostname-sicher-ubernehmen.js"},
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1260,
    "y": 180,
    "wires": [["system_scan_result"]]
  },
  {
    "id": "system_scan_result",
    "type": "function",
    "z": "system_network_flow",
    "name": "Online-Liste mit Hostnamen bilden",
    "func": {"$flowSource": "flows/system-netzwerk--system_network_flow/functions/online-liste-mit-hostnamen-bilden.js"},
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 535,
    "y": 300,
    "wires": [["system_dashboard_data_out", "system_scan_debug"]]
  },
  {
    "id": "system_dashboard_data_out",
    "type": "link out",
    "z": "system_network_flow",
    "name": "Online-Geräteliste an SYSTEM-Dashboard",
    "mode": "link",
    "links": ["system_dashboard_data_in"],
    "x": 1095,
    "y": 220,
    "wires": []
  },
  {
    "id": "system_scan_debug",
    "type": "debug",
    "z": "system_network_flow",
    "name": "Systemnetz · geprüfte Online-Liste",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 1105,
    "y": 280,
    "wires": []
  }
]
