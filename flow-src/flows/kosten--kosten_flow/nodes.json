      ]
    ]
  },
  {
    "id": "kosten_forecast_provider_catch",
    "type": "catch",
    "z": "kosten_flow",
    "name": "Tariff provider unavailable",
    "scope": [
      "kosten_awattar_api",
      "kosten_aktuellen_tarif_aufbereiten"
    ],
    "uncaught": false,
    "x": 250,
    "y": 420,
    "wires": [
      [
        "kosten_forecast_provider_offline"
      ]
    ]
  },
  {
    "id": "kosten_forecast_provider_offline",
    "type": "change",
    "z": "kosten_flow",
    "name": "Normalize unavailable tariff provider",
    "rules": [
      {
        "t": "set",
        "p": "topic",
        "pt": "msg",
        "to": "energy/forecast/provider",
        "tot": "str"
      },
      {
        "t": "set",
        "p": "payload",
        "pt": "msg",
        "to": "{\"provider\":\"aWATTar\",\"online\":false,\"slots\":[]}",
        "tot": "json"
      }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 550,
    "y": 420,
    "wires": [
      [
        "kosten_forecast_provider_out"
      ]
    ]
  }
]
