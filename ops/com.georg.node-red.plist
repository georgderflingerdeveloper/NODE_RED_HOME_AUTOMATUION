<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.georg.node-red</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/node-red</string>
        <string>--userDir</string>
        <string>/Users/papa/.node-red</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/papa</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/Users/papa/.node-red/node-red-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/papa/.node-red/node-red-launchd-error.log</string>
</dict>
</plist>
